__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={languageSelector:'v\xe6lg sprog',nearby_interpreter:'Tolke n\xe6r dig',police_approved:'Politigodkendt',label1:'Teknisk overs\xe6ttelse',label2:'Juridisk overs\xe6ttelse',label3:'Sundhedsovers\xe6ttelse',label4:'Almen overs\xe6ttelse',label5:'SEO-overs\xe6ttelse',label6:'Tekstforfatter',label7:'Transskribering',label8:'Korrekturl\xe6sning',label9:'Retssager ',woman:'Kvinde',man:'Mand',city:'By',zipcode:'Postnummer',language:'Sprog',contact:'Kontakt',book:'Bestil',booking:'Booking',details:'Detaljer',edit:'Redigere',direction:'Retning',add:'Tilf\xf8je',calendar:'Kalender',away:'Away',select:'V\xe6lg',type_of_interpretation:'Type af tolkning',phone:'Telefon',video:'Video',attendance:'Fremm\xf8de',date:'Dato',start_time:'Starttid',end_time:'Sluttid',duration:'Varighed',price:'Pris',booking_for_self:'Telefon beaked til boorger',citizen_details:'Detaljer om borger',name:'navn',citizen:'Borgeren',case_number:'Sagsnummer/Borgerens f\xf8dselsdagsdato',comment:'Bem\xe6rkninger',meeting_point:'M\xf8dested',use_my_address:'Brug min adresse',order:'Bestilling',order_overview:'Ordreoversigt',distance:'Afstand',multiply_by:'hver vej',transport_fee:'Transporttakst',total_fee:'Samlet gebyr',translated_from:'Oversat fra',translated_to:'Oversat til',back:'Tilbage',confirm:'Bekr\xe6ft',my_profile:'Min Profil',profile:'Profil',buyers:'k\xf8ber',requests:'Anmodning',post:'Stolpe',manage:'Styre',terms:'adf\xe6rd',privacy_policy:'privatliv',consumer_terms:'Forbrugervilk\xe5r',interpreter_castle:'Tolkeborg',skills:'F\xe6rdigheder',available:'Tilg\xe6ngelig',logout:'Log ud',first:'F\xf8r',last:'Efter',address:'Adresse',email:'E-mail',number:'Nummer',date_of_birth:'F\xf8dselsdato',about:'Om',account:'Konto',company:'Selskab',yes:'Ja',level:'Niveau',fluent:'Flydende',moderate:'Modersm\xe5l',save:'Gem',rating:'Bed\xf8mmelse',status:'Status',fee:'Betaling',tasktype:'Opgavetype',customer:'Kun